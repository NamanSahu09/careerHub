# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/careerhub

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Seed admin (used by `npm run seed:admin`)
ADMIN_NAME=CareerHub Admin
ADMIN_EMAIL=admin@careerhub.example
ADMIN_PASSWORD=Admin@1234
ADMIN_PHONE=9861551246

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
