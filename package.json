{
  "name": "careerhub-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace wrapper for the CareerHub project (React + Express + MongoDB)",
  "main": "index.js",
  "workspaces": [
    "careerhub",
    "careerhub-backend"
  ],
  "scripts": {
    "start": "node server.js",
    "install-backend": "npm install --prefix careerhub-backend",
    "install-frontend": "npm install --prefix careerhub",
    "install-all": "npm install && npm run install-backend && npm run install-frontend",
    "dev-backend": "npm run dev --prefix careerhub-backend",
    "dev-frontend": "npm run dev --prefix careerhub",
    "dev": "concurrently --kill-others-on-fail \"npm run dev-backend\" \"npm run dev-frontend\"",
    "seed": "node careerhub-backend/scripts/seedData.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
